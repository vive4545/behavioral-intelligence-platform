{
  "name": "@interviewiq/server",
  "version": "0.0.1",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsx watch src/standalone.ts",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@interviewiq/core": "*",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@interviewiq/typescript-config": "*",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "^1.2.1"
  }
}
